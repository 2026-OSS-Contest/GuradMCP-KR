{
  "name": "guardmcp-kr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Korean privacy-first security gateway for MCP tool calls",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22",
    "npm": "10.x"
  },
  "workspaces": [
    "apps/console",
    "apps/demo-mcp-tools",
    "packages/*"
  ],
  "overrides": {
    "next": "16.3.0-preview.8",
    "postcss": "8.5.10"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings=0 && npm run lint --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && npm run typecheck --workspaces --if-present",
    "pretest": "npm run build --workspace @guardmcp/policy-engine",
    "test": "vitest run --coverage",
    "pretest:unit": "npm run build --workspace @guardmcp/policy-engine",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --config apps/console/playwright.config.ts",
    "bench": "tsx attack-lab/benchmark/run.ts",
    "attacklab": "tsx attack-lab/runner/run.ts",
    "policy:generate": "tsx scripts/compile-runtime-policies.ts",
    "policy:check-generated": "tsx scripts/compile-runtime-policies.ts --check",
    "policy:validate": "tsx scripts/validate-policies.ts && npm run policy:generate",
    "scenarios:validate": "tsx scripts/validate-scenarios.ts",
    "license:report": "node scripts/ci/generate-license-report.mjs --output artifacts/licenses",
    "figma:bridge": "node apps/console/tools/figma-tokens/bridge/server.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run policy:validate && npm run scenarios:validate && npm run bench && npm run attacklab"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.15",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "yaml": "^2.8.0"
  }
}
