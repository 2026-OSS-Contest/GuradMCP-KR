{
  "version": 1,
  "type": "SECRET",
  "rules": [
    {
      "subtype": "LLM_API_KEY",
      "description": "OpenAI or Anthropic API key prefix",
      "pattern": "\\b(?:sk-ant-|sk-)[A-Za-z0-9_-]{16,}\\b",
      "flags": "g",
      "maskedAs": "[SECRET]",
      "confidence": 0.95
    },
    {
      "subtype": "GITHUB_TOKEN",
      "description": "GitHub personal access token",
      "pattern": "\\b(?:ghp_|github_pat_)[A-Za-z0-9_]{20,}\\b",
      "flags": "g",
      "maskedAs": "[SECRET]",
      "confidence": 0.95
    },
    {
      "subtype": "AWS_ACCESS_KEY",
      "description": "AWS access key identifier",
      "pattern": "\\b(?:AKIA|ASIA)[A-Z0-9]{16}\\b",
      "flags": "g",
      "maskedAs": "[SECRET]",
      "confidence": 0.95
    },
    {
      "subtype": "JWT",
      "description": "JSON Web Token in three base64url segments",
      "pattern": "\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b",
      "flags": "g",
      "maskedAs": "[SECRET]",
      "confidence": 0.9
    },
    {
      "subtype": "PRIVATE_KEY",
      "description": "PEM private key block header",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "flags": "g",
      "maskedAs": "[SECRET]",
      "confidence": 0.99
    },
    {
      "subtype": "KOREAN_SERVICE_TOKEN",
      "description": "Kakao, Naver, or Toss credential assignment",
      "pattern": "\\b(?:kakao|naver|toss)[_-]?(?:api[_-]?)?(?:key|token)[=:][A-Za-z0-9_-]{16,}\\b",
      "flags": "gi",
      "maskedAs": "[SECRET]",
      "confidence": 0.9
    }
  ]
}
