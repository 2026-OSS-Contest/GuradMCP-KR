{
  "version": 1,
  "type": "SECRET",
  "rules": [
    {
      "subtype": "LLM_API_KEY",
      "description": "OpenAI or Anthropic API key prefix",
      "pattern": "\\b(?:sk-ant-|sk-)[A-Za-z0-9_-]{20,}\\b",
      "flags": "g",
      "maskedAs": "[SECRET]",
      "confidence": 0.95
    },
    {
      "subtype": "GITHUB_TOKEN",
      "description": "GitHub personal access token (classic ghp_/gho_ or fine-grained github_pat_)",
      "pattern": "\\b(?:gh[po]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{22,})\\b",
      "flags": "g",
      "maskedAs": "[GITHUB_TOKEN]",
      "confidence": 0.95
    },
    {
      "subtype": "AWS_KEY",
      "description": "AWS access key id (long-term AKIA or STS temporary ASIA)",
      "pattern": "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "flags": "g",
      "maskedAs": "[AWS_KEY]",
      "confidence": 0.95
    },
    {
      "subtype": "AWS_SECRET_KEY_CONTEXT",
      "description": "AWS secret access key assignment context (aws_secret_access_key=...)",
      "pattern": "\\baws_secret_access_key\\s*[:=]\\s*['\"]?[A-Za-z0-9/+]{40}={0,2}['\"]?",
      "flags": "gi",
      "maskedAs": "[AWS_KEY]",
      "confidence": 0.9
    },
    {
      "subtype": "WEBHOOK_SLACK",
      "description": "Slack incoming webhook URL",
      "pattern": "https://hooks\\.slack\\.com/services/T[0-9A-Z]+/B[0-9A-Z]+/[0-9A-Za-z]+",
      "flags": "g",
      "maskedAs": "[WEBHOOK]",
      "confidence": 0.9
    },
    {
      "subtype": "WEBHOOK_DISCORD",
      "description": "Discord webhook URL",
      "pattern": "https://discord(?:app)?\\.com/api/webhooks/\\d+/[\\w-]+",
      "flags": "g",
      "maskedAs": "[WEBHOOK]",
      "confidence": 0.9
    },
    {
      "subtype": "JWT",
      "description": "JSON Web Token, three base64url segments whose header/payload decode as JSON",
      "pattern": "\\beyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b",
      "flags": "g",
      "maskedAs": "[JWT]",
      "confidence": 0.9,
      "validate": "jwtStructure",
      "onValidationFailure": "downgrade",
      "unvalidatedConfidence": 0.3
    },
    {
      "subtype": "PRIVATE_KEY",
      "description": "PEM private key block, BEGIN/END pair matched across the full body",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----[\\s\\S]+?-----END (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----",
      "flags": "g",
      "maskedAs": "[PRIVATE_KEY]",
      "confidence": 0.99
    },
    {
      "subtype": "KOREAN_SERVICE_TOKEN",
      "description": "Kakao, Naver, or Toss credential assignment",
      "pattern": "\\b(?:kakao|naver|toss)[_-]?(?:api[_-]?)?(?:key|token)[=:][A-Za-z0-9_-]{16,}\\b",
      "flags": "gi",
      "maskedAs": "[SECRET]",
      "confidence": 0.9
    }
  ]
}
