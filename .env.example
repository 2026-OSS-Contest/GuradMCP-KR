# GuardMCP-KR local Compose defaults. These credentials are for the disposable
# demo/development stack only; never reuse them in a shared or production setup.
COMPOSE_PROJECT_NAME=guardmcp-kr
GUARDMCP_PROFILE=demo
GUARDMCP_VERSION=dev
GUARDMCP_REGISTRY=ghcr.io/2026-oss-contest
GUARDMCP_IMAGE_TAG=local

CONSOLE_PORT=3000
GATEWAY_PORT=3001
DEMO_AGENT_PORT=3002
DEMO_MCP_TOOLS_PORT=3003
CONTROL_PLANE_PORT=8080

POSTGRES_DB=guardmcp
POSTGRES_USER=guardmcp
POSTGRES_PASSWORD=guardmcp-local-only
POSTGRES_PORT=5432

REDIS_PASSWORD=guardmcp-local-only
REDIS_PORT=6379

# GMCP-30: maximum time from Compose start to a reachable console.
COMPOSE_READY_TIMEOUT_SECONDS=300

# NFR-04: shared secret POST /events/{id}/reveal requires as an X-Operator-Token header, on top
# of the (forgeable, no real auth system exists yet) X-Actor-Role: operator header. Left unset,
# reveal stays disabled — set this to exercise the reveal flow locally.
REVEAL_OPERATOR_TOKEN=

# Shared secret POST /policies/sync requires as an X-Sync-Token header — the Gateway pushes the
# pack/policy set it just loaded through this endpoint on every boot/hot-reload (fix-api.md §1),
# and it is the only writer of the Control Plane's policy registry. Unlike REVEAL_OPERATOR_TOKEN
# this isn't optional to the demo stack (an unset token leaves PolicyStore permanently empty, so
# the console's policies screens never populate), so it gets a real local-only default like
# POSTGRES_PASSWORD/REDIS_PASSWORD above rather than shipping disabled.
POLICY_SYNC_TOKEN=guardmcp-local-only
